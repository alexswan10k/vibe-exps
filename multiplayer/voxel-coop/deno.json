{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --allow-sys server/main.ts",
    "peaceful": "deno run --allow-net --allow-read --allow-write --allow-env --allow-sys server/main.ts -- --peaceful",
    "creative": "deno run --allow-net --allow-read --allow-write --allow-env --allow-sys server/main.ts -- --creative",
    "reset": "rm -f data/world.json data/players.json data/machines.json && echo 'saves wiped — next start generates a fresh world'",
    "check": "deno check server/main.ts"
  }
}
